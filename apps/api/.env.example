# HTTP server.
PORT=4000

# Browser origin allowed by CORS. Must be the deployed web origin in
# production; the default is the local Next.js dev server.
WEB_ORIGIN=http://localhost:3000

# MongoDB connection string (MongoDB Atlas or a self-hosted replica set).
# A replica set is REQUIRED: audited mutations use multi-document
# transactions. A standalone mongod cannot serve HSE write endpoints.
MONGODB_URI=

# DigitAuth service credentials used for bearer-token introspection.
DIGIT_AUTH_API_URL=
DIGIT_AUTH_CLIENT_ID=
DIGIT_AUTH_CLIENT_SECRET=

# Shared secret used to verify DigitAuth webhook HMAC signatures.
DIGITAUTH_WEBHOOK_SECRET=

# Private local directory for attachment bytes. Never served publicly.
# Requirements: outside the web root, writable only by the API process,
# persistent across deployments, covered by backups, and not on an
# ephemeral/container filesystem.
ATTACHMENT_STORAGE_DIR=./storage/attachments
